{
  "name": "valorant-store-watcher",
  "version": "1.3.2",
  "description": "VALORANTのデイリーストアを監視し、ウィッシュリストのスキンが出たらDiscordに通知する非公式デスクトップアプリ",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "headless": "vite-node src/headless/cli.ts --",
    "dist:win": "electron-vite build && electron-builder --win nsis --x64 --publish never",
    "dist": "electron-vite build && electron-builder",
    "dist:win:nowine": "node scripts/build-win-installer.mjs"
  },
  "author": "VALORANT Store Watcher contributors",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.11",
    "sql.js": "^1.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.16.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  },
  "productName": "VALORANT Store Watcher",
  "private": true
}
