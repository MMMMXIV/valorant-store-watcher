{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "types": []
  },
  "include": ["src/renderer/src/**/*", "src/core/types.ts", "src/core/settings.ts", "src/core/util/time.ts", "src/core/util/ids.ts"]
}
